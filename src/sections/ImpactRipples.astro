---
// ImpactRipples section placeholder
---

<section id="impact" class="py-24 relative" data-animate>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-4xl md:text-6xl font-display font-bold text-center mb-16" data-text-reveal>
      Impact
    </h2>
    <div class="text-center">
      <p class="text-xl text-[var(--muted)] max-w-3xl mx-auto" data-animate>
        Creating ripple effects that extend beyond code, contributing to research, education, and social good.
      </p>
    </div>
  </div>

  <!-- Ripple animation background -->
  <div class="absolute inset-0 pointer-events-none">
    <div id="ripples-container" class="w-full h-full"></div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  // Create animated ripples
  function createRipple() {
    const container = document.getElementById('ripples-container');
    const ripple = document.createElement('div');
    ripple.className = 'absolute border border-[var(--primary)]/20 rounded-full';

    const size = Math.random() * 200 + 50;
    const x = Math.random() * window.innerWidth;
    const y = Math.random() * window.innerHeight;

    gsap.set(ripple, {
      width: 0,
      height: 0,
      x: x,
      y: y,
      opacity: 0.5
    });

    container.appendChild(ripple);

    gsap.to(ripple, {
      width: size,
      height: size,
      opacity: 0,
      duration: 3,
      ease: "power2.out",
      onComplete: () => ripple.remove()
    });
  }

  // Create ripples periodically
  setInterval(createRipple, 2000);
</script>