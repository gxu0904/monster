---
// Enhanced Footer with advanced animations
---

<footer
  class="relative border-t border-[var(--graphite)] py-12 px-4 sm:px-6 lg:px-8 overflow-hidden"
  data-animate
>
  <!-- Animated background gradient -->
  <div class="absolute inset-0 bg-gradient-to-t from-[#0A0F1C] to-transparent opacity-50"></div>

  <!-- Content container -->
  <div class="relative max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">

      <!-- Logo and status indicator -->
      <div class="flex items-center gap-4" data-animate>
        <div class="flex items-center gap-2">
          <span class="text-[var(--muted)] text-sm">
            © {new Date().getFullYear()} Grace Xu
          </span>

          <!-- Enhanced status indicator with multiple bars -->
          <div class="flex items-center gap-1 ml-4">
            {[1, 2, 3, 4].map((i) => (
              <div
                class={`status-bar w-1 h-4 bg-[var(--primary)] rounded-full`}
                style={`animation-delay: ${i * 0.2}s`}
              ></div>
            ))}
          </div>

          <!-- Live status text -->
          <div class="flex items-center gap-2 ml-4">
            <div class="w-2 h-2 bg-[var(--primary)] rounded-full animate-pulse"></div>
            <span class="text-xs text-[var(--muted)] font-mono">ONLINE</span>
          </div>
        </div>
      </div>

      <!-- Enhanced social links with hover effects -->
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/gracexu-dev"
          target="_blank"
          rel="noopener noreferrer"
          class="social-link group relative p-3 rounded-full bg-[var(--graphite)] text-[var(--fg)] hover:bg-[var(--primary)] transition-all duration-300 overflow-hidden"
          data-magnetic
          data-animate
          aria-label="GitHub"
        >
          <svg class="w-5 h-5 relative z-10" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.374 0 0 5.373 0 12 0 17.302 3.438 21.8 8.207 23.387c.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>

          <!-- Ripple effect -->
          <div class="absolute inset-0 rounded-full bg-[var(--primary)] scale-0 group-hover:scale-100 transition-transform duration-500 ease-out opacity-20"></div>
        </a>

        <a
          href="https://www.linkedin.com/in/grace-xu-dev"
          target="_blank"
          rel="noopener noreferrer"
          class="social-link group relative p-3 rounded-full bg-[var(--graphite)] text-[var(--fg)] hover:bg-[var(--primary)] transition-all duration-300 overflow-hidden"
          data-magnetic
          data-animate
          aria-label="LinkedIn"
        >
          <svg class="w-5 h-5 relative z-10" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>

          <div class="absolute inset-0 rounded-full bg-[var(--primary)] scale-0 group-hover:scale-100 transition-transform duration-500 ease-out opacity-20"></div>
        </a>

        <a
          href="mailto:grace.xu@example.com"
          class="social-link group relative p-3 rounded-full bg-[var(--graphite)] text-[var(--fg)] hover:bg-[var(--primary)] transition-all duration-300 overflow-hidden"
          data-magnetic
          data-animate
          aria-label="Email"
        >
          <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>

          <div class="absolute inset-0 rounded-full bg-[var(--primary)] scale-0 group-hover:scale-100 transition-transform duration-500 ease-out opacity-20"></div>
        </a>

        <a
          href="/resume.txt"
          target="_blank"
          class="social-link group relative p-3 rounded-full bg-[var(--graphite)] text-[var(--fg)] hover:bg-[var(--primary)] transition-all duration-300 overflow-hidden"
          data-magnetic
          data-animate
          aria-label="Resume"
        >
          <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>

          <div class="absolute inset-0 rounded-full bg-[var(--primary)] scale-0 group-hover:scale-100 transition-transform duration-500 ease-out opacity-20"></div>
        </a>
      </div>
    </div>

    <!-- Additional footer content -->
    <div class="mt-8 pt-8 border-t border-[var(--graphite)]/30">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-[var(--muted)]">
        <div class="flex items-center gap-4" data-animate>
          <span>Built with Astro, GSAP, and lots of ☕</span>
          <div class="hidden md:flex items-center gap-2">
            <div class="w-1 h-1 bg-[var(--muted)] rounded-full"></div>
            <span id="build-time" class="font-mono"></span>
          </div>
        </div>

        <div class="flex items-center gap-6" data-animate>
          <a
            href="/sitemap.xml"
            class="hover:text-[var(--primary)] transition-colors duration-200"
            data-magnetic
          >
            Sitemap
          </a>
          <a
            href="/rss.xml"
            class="hover:text-[var(--primary)] transition-colors duration-200"
            data-magnetic
          >
            RSS
          </a>
          <button
            id="theme-toggle"
            class="hover:text-[var(--primary)] transition-colors duration-200"
            data-magnetic
            aria-label="Toggle theme"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Animated decoration -->
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-[var(--primary)] via-[var(--accent)] to-[var(--primary)] opacity-30">
    <div class="h-full bg-gradient-to-r from-transparent via-[var(--primary)] to-transparent animate-pulse"></div>
  </div>
</footer>

<script>
  import { gsap } from 'gsap';

  // Status bar animations with enhanced timing
  document.querySelectorAll('.status-bar').forEach((bar, index) => {
    gsap.to(bar, {
      scaleY: [1, 1.8, 1.2, 1.5, 1],
      opacity: [0.5, 1, 0.7, 0.9, 0.6],
      duration: 2,
      repeat: -1,
      delay: index * 0.15,
      ease: "power2.inOut"
    });
  });

  // Enhanced social link interactions
  document.querySelectorAll('.social-link').forEach(link => {
    link.addEventListener('mouseenter', () => {
      // Scale and glow effect
      gsap.to(link, {
        scale: 1.1,
        boxShadow: '0 8px 25px rgba(0, 168, 232, 0.4)',
        duration: 0.3,
        ease: "power2.out"
      });

      // Icon bounce
      const icon = link.querySelector('svg');
      gsap.to(icon, {
        scale: 1.2,
        rotation: 5,
        duration: 0.2,
        ease: "back.out(1.7)"
      });
    });

    link.addEventListener('mouseleave', () => {
      gsap.to(link, {
        scale: 1,
        boxShadow: '0 0 0 rgba(0, 168, 232, 0)',
        duration: 0.3,
        ease: "power2.out"
      });

      const icon = link.querySelector('svg');
      gsap.to(icon, {
        scale: 1,
        rotation: 0,
        duration: 0.3,
        ease: "power2.out"
      });
    });

    // Click ripple effect
    link.addEventListener('click', (e) => {
      const ripple = link.querySelector('.absolute.inset-0');

      gsap.set(ripple, { scale: 0 });
      gsap.to(ripple, {
        scale: 1,
        duration: 0.6,
        ease: "power2.out"
      });
    });
  });

  // Build time display
  const buildTime = document.getElementById('build-time');
  if (buildTime) {
    const now = new Date();
    const timeString = now.toLocaleTimeString('en-US', {
      hour12: false,
      hour: '2-digit',
      minute: '2-digit'
    });
    buildTime.textContent = `Built at ${timeString}`;
  }

  // Theme toggle functionality (placeholder)
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    // Add theme switching logic here
    gsap.fromTo(themeToggle,
      { rotation: 0 },
      { rotation: 360, duration: 0.5, ease: "power2.inOut" }
    );
  });

  // Footer entrance animation on scroll
  gsap.fromTo("footer",
    {
      y: 100,
      opacity: 0
    },
    {
      y: 0,
      opacity: 1,
      duration: 1,
      ease: "power3.out",
      scrollTrigger: {
        trigger: "footer",
        start: "top bottom-=100",
        end: "bottom bottom",
        toggleActions: "play none none reverse"
      }
    }
  );

  // Staggered animation for footer content
  gsap.fromTo("footer [data-animate]",
    {
      y: 30,
      opacity: 0
    },
    {
      y: 0,
      opacity: 1,
      duration: 0.6,
      stagger: 0.1,
      ease: "power2.out",
      scrollTrigger: {
        trigger: "footer",
        start: "top bottom-=50",
        toggleActions: "play none none reverse"
      }
    }
  );

  // Continuous subtle animation for online indicator
  gsap.to("footer .animate-pulse", {
    scale: [1, 1.2, 1],
    opacity: [1, 0.6, 1],
    duration: 2,
    repeat: -1,
    ease: "power2.inOut"
  });
</script>

<style>
  .status-bar {
    transform-origin: bottom;
    background: linear-gradient(to top, var(--primary), var(--accent));
  }

  .social-link {
    position: relative;
    backdrop-filter: blur(10px);
  }

  .social-link::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    padding: 1px;
    background: linear-gradient(45deg, var(--primary), transparent, var(--accent));
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .social-link:hover::before {
    opacity: 1;
  }
</style>