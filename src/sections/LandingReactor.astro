---
// Animation-heavy Landing section with interactive elements
---

<section
  id="landing"
  class="relative min-h-screen flex items-center justify-center bg-[var(--bg)] overflow-hidden"
  data-gradient-mesh
  data-floating-shapes
  data-shape-count="8"
>
  <!-- Interactive particle system -->
  <div class="absolute inset-0 pointer-events-auto" id="interactive-particles" data-particles data-particle-count="60" data-particle-color="rgba(30, 58, 95, 0.3)"></div>

  <!-- Animated background grid with parallax -->
  <div class="absolute inset-0 opacity-10 pointer-events-none" data-parallax data-speed="0.3">
    <div class="grid-pattern w-full h-full"></div>
  </div>

  <!-- Large floating gradient orbs -->
  <div class="absolute top-10 left-10 w-96 h-96 rounded-full bg-gradient-to-br from-[var(--primary)]/15 to-transparent blur-3xl float pointer-events-none" data-parallax data-speed="0.2" style="animation-delay: 0s;"></div>
  <div class="absolute bottom-10 right-10 w-[500px] h-[500px] rounded-full bg-gradient-to-tr from-[var(--accent)]/12 to-transparent blur-3xl float pointer-events-none" data-parallax data-speed="0.35" style="animation-delay: 1.5s;"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 rounded-full bg-gradient-to-br from-[var(--primary)]/8 to-transparent blur-3xl rotate-slow pointer-events-none"></div>

  <!-- Custom cursor aura -->
  <div id="cursor-aura" class="custom-cursor">
    <div class="cursor-dot"></div>
  </div>

  <!-- Main content with heavy animations -->
  <div class="relative z-10 text-center max-w-5xl mx-auto px-4 perspective-1000 pointer-events-none">
    <!-- Animated title with spectacular effects -->
    <h1 class="mb-8" data-animate>
      <!-- Name on one row -->
      <div class="relative inline-block w-full">
        <div class="flex items-center justify-center gap-6 md:gap-10 lg:gap-16 flex-wrap">
          <!-- First name with individual letter animations -->
          <div class="relative inline-block">
            <span
              id="first-name"
              class="font-display text-7xl md:text-9xl lg:text-[10rem] xl:text-[14rem] font-bold text-[var(--fg)] leading-none animated-name"
              style="transform-origin: center; will-change: transform, opacity; opacity: 0;"
            >
              Grace
            </span>
            <!-- Particle container for first name -->
            <div id="first-name-particles" class="absolute inset-0 pointer-events-none"></div>
          </div>

          <!-- Last name with animated gradient -->
          <div class="relative inline-block">
            <span
              id="last-name"
              class="font-display text-7xl md:text-9xl lg:text-[10rem] xl:text-[14rem] font-bold leading-none animated-name"
              style="transform-origin: center; will-change: transform, opacity; opacity: 0;"
            >
              Xu
            </span>
            <!-- Particle container for last name -->
            <div id="last-name-particles" class="absolute inset-0 pointer-events-none"></div>

            <!-- Animated gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-r from-[var(--primary)] via-[var(--accent)] to-[var(--primary)] bg-[length:200%_100%] animate-gradient-flow opacity-80 bg-clip-text text-transparent mix-blend-multiply pointer-events-none"></div>
          </div>
        </div>
      </div>
    </h1>

    <!-- Animated subtitle with character reveal -->
    <div class="mb-16" data-animate style="animation-delay: 0.4s;">
      <p class="text-2xl md:text-3xl lg:text-4xl text-[var(--muted)] font-light" data-char-reveal style="will-change: transform, opacity;">
        Engineer. Researcher. Builder.
      </p>
    </div>

    <!-- Magnetic CTA buttons with enhanced effects -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-6 pointer-events-auto" data-animate style="animation-delay: 0.6s;">
      <a
        href="#projects"
        class="group relative px-10 py-4 bg-[var(--primary)] text-[var(--bg)] font-semibold rounded-xl overflow-hidden hover-scale pulse-glow interactive-button"
        data-magnetic
        data-magnetic-strength="0.5"
        data-hover-lift
        style="will-change: transform; transform-style: preserve-3d;"
      >
        <span class="relative z-10 flex items-center gap-2">
          View Work
          <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </span>
        <div class="absolute inset-0 bg-gradient-to-r from-[var(--accent)] to-[var(--primary)] transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
        <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          <div class="absolute top-0 left-0 w-full h-full shimmer"></div>
        </div>
      </a>

      <a
        href="#contact"
        class="group relative px-10 py-4 glass-morphism text-[var(--primary)] font-semibold rounded-xl overflow-hidden hover-scale interactive-button"
        data-magnetic
        data-magnetic-strength="0.5"
        data-hover-lift
        style="will-change: transform; border: 1px solid rgba(30, 58, 95, 0.2);"
      >
        <span class="relative z-10 flex items-center gap-2">
          Get In Touch
          <svg class="w-5 h-5 transform group-hover:rotate-45 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </span>
        <div class="absolute inset-0 bg-[var(--primary)]/10 transform scale-0 group-hover:scale-100 transition-transform duration-500 rounded-xl"></div>
      </a>
    </div>

    <!-- Animated scroll indicator with pulse -->
    <div class="absolute bottom-16 left-1/2 -translate-x-1/2 pointer-events-auto" data-animate style="animation-delay: 0.8s;">
      <a
        href="#about"
        class="flex flex-col items-center gap-3 text-[var(--muted)] hover:text-[var(--primary)] transition-all duration-300 group"
        data-magnetic
        data-magnetic-strength="0.3"
      >
        <span class="text-sm font-medium tracking-wide uppercase">Scroll</span>
        <div class="relative">
          <svg class="w-6 h-6 animate-bounce" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
          </svg>
          <div class="absolute inset-0 w-6 h-6 bg-[var(--primary)]/20 rounded-full blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .grid-pattern {
    background-image:
      linear-gradient(to right, rgba(30, 58, 95, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(30, 58, 95, 0.05) 1px, transparent 1px);
    background-size: 60px 60px;
    animation: gridMove 30s linear infinite;
  }

  @keyframes gridMove {
    0% {
      background-position: 0 0;
    }
    100% {
      background-position: 60px 60px;
    }
  }

  /* Spectacular name animations */
  .animated-name {
    position: relative;
    cursor: pointer;
    pointer-events: auto;
  }

  /* Flowing gradient animation */
  @keyframes gradient-flow {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .animate-gradient-flow {
    animation: gradient-flow 4s ease infinite;
  }

  /* Individual letter wrapper */
  .letter {
    display: inline-block;
    position: relative;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    cursor: pointer;
    pointer-events: auto;
  }

  /* Letter hover effects - each gets unique animation */
  .letter:hover {
    animation: letterBounce 0.6s ease !important;
  }

  .letter:nth-child(1):hover { animation: letterRotate 0.6s ease !important; }
  .letter:nth-child(2):hover { animation: letterScale 0.6s ease !important; }
  .letter:nth-child(3):hover { animation: letterFlip 0.6s ease !important; }
  .letter:nth-child(4):hover { animation: letterWobble 0.6s ease !important; }
  .letter:nth-child(5):hover { animation: letterElastic 0.6s ease !important; }
  .letter:nth-child(6):hover { animation: letterBounce 0.6s ease !important; }
  .letter:nth-child(7):hover { animation: letterRotate 0.6s ease !important; }

  @keyframes letterBounce {
    0%, 100% { transform: translateY(0) scale(1); }
    25% { transform: translateY(-30px) scale(1.15); }
    50% { transform: translateY(-15px) scale(1.08); }
    75% { transform: translateY(-25px) scale(1.12); }
  }

  @keyframes letterRotate {
    0%, 100% { transform: rotate(0deg) scale(1); }
    25% { transform: rotate(20deg) scale(1.2); }
    50% { transform: rotate(-15deg) scale(1.15); }
    75% { transform: rotate(12deg) scale(1.18); }
  }

  @keyframes letterScale {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.4) rotate(8deg); }
  }

  @keyframes letterFlip {
    0%, 100% { transform: rotateY(0deg); }
    50% { transform: rotateY(180deg) scale(1.3); }
  }

  @keyframes letterWobble {
    0%, 100% { transform: translateX(0) rotate(0deg); }
    25% { transform: translateX(-15px) rotate(-8deg); }
    50% { transform: translateX(15px) rotate(8deg); }
    75% { transform: translateX(-8px) rotate(-5deg); }
  }

  @keyframes letterElastic {
    0%, 100% { transform: scale(1, 1); }
    25% { transform: scale(1.3, 0.7); }
    50% { transform: scale(0.7, 1.3); }
    75% { transform: scale(1.2, 0.9); }
  }

  /* Glitch effect */
  .letter.glitch {
    animation: glitch 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  @keyframes glitch {
    0%, 100% {
      transform: translate(0);
      opacity: 1;
    }
    20% {
      transform: translate(-3px, 3px);
      opacity: 0.8;
    }
    40% {
      transform: translate(3px, -3px);
      opacity: 0.8;
    }
    60% {
      transform: translate(-2px, -2px);
      opacity: 0.9;
    }
    80% {
      transform: translate(2px, 2px);
      opacity: 0.8;
    }
  }

  /* Rainbow effect on hover */
  .letter.rainbow {
    background: linear-gradient(
      45deg,
      #ff0000,
      #ff7f00,
      #ffff00,
      #00ff00,
      #0000ff,
      #4b0082,
      #9400d3
    );
    background-size: 300% 300%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: rainbow 2s linear infinite;
  }

  @keyframes rainbow {
    0% { background-position: 0% 50%; }
    100% { background-position: 100% 50%; }
  }

  /* Letter glow effect */
  .letter-glow {
    filter: drop-shadow(0 0 10px rgba(30, 58, 95, 0.5))
            drop-shadow(0 0 20px rgba(30, 58, 95, 0.3))
            drop-shadow(0 0 30px rgba(30, 58, 95, 0.1));
  }

  /* Particle effects */
  .name-particle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--primary);
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
  }

  /* Enhanced button hover effects */
  .interactive-button {
    position: relative;
    overflow: hidden;
  }

  .interactive-button::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
  }

  .interactive-button:hover::before {
    width: 300px;
    height: 300px;
  }

  /* Enhanced focus states for better UX */
  a:focus-visible, button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 4px;
  }
</style>

<script>
  import { gsap } from 'gsap';

  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      const href = this.getAttribute('href');
      if (href && href !== '#' && href.startsWith('#')) {
        e.preventDefault();
        const target = document.querySelector(href);
        if (target) {
          const headerOffset = 100;
          const elementPosition = target.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
        }
      }
    });
  });

  // Spectacular name letter effects
  function initNameEffects() {
    const firstName = document.getElementById('first-name');
    const lastName = document.getElementById('last-name');

    if (!firstName || !lastName) return;

    // Immediate fade in with GSAP
    gsap.to([firstName, lastName], {
      opacity: 1,
      duration: 0.8,
      ease: "power2.out",
      stagger: 0.2
    });

    // Split names into individual letters immediately after fade
    setTimeout(() => {
      // Split names into individual letters
      function splitIntoLetters(element) {
        const text = element.textContent;
        element.innerHTML = '';

        text.split('').forEach((char, index) => {
          const span = document.createElement('span');
          span.textContent = char;
          span.className = 'letter';
          span.style.display = 'inline-block';
          span.style.transformOrigin = 'center';
          span.style.willChange = 'transform';
          element.appendChild(span);
        });

        return element.querySelectorAll('.letter');
      }

      const firstNameLetters = splitIntoLetters(firstName);
      const lastNameLetters = splitIntoLetters(lastName);

      // Add individual letter interactions
      function setupLetterInteractions(letters, particleContainer) {
        letters.forEach((letter, index) => {
          // Hover glow effect
          letter.addEventListener('mouseenter', () => {
            letter.classList.add('letter-glow');

            // Emit particles
            emitParticles(letter, particleContainer);

            // Random chance for glitch effect
            if (Math.random() > 0.7) {
              letter.classList.add('glitch');
              setTimeout(() => letter.classList.remove('glitch'), 300);
            }
          });

          letter.addEventListener('mouseleave', () => {
            letter.classList.remove('letter-glow');
          });

          // Click for rainbow effect
          letter.addEventListener('click', (e) => {
            e.stopPropagation();
            letter.classList.add('rainbow');

            // Create burst effect
            createLetterBurst(letter, particleContainer);

            setTimeout(() => letter.classList.remove('rainbow'), 2000);
          });
        });
      }

      // Particle emission from letters
      function emitParticles(letter, container) {
        const rect = letter.getBoundingClientRect();
        const containerRect = container.getBoundingClientRect();
        const particleCount = 8;

        for (let i = 0; i < particleCount; i++) {
          const particle = document.createElement('div');
          particle.className = 'name-particle';

          const x = rect.left - containerRect.left + rect.width / 2;
          const y = rect.top - containerRect.top + rect.height / 2;

          particle.style.left = `${x}px`;
          particle.style.top = `${y}px`;

          container.appendChild(particle);

          const angle = (Math.PI * 2 * i) / particleCount;
          const velocity = 30 + Math.random() * 20;
          const tx = Math.cos(angle) * velocity;
          const ty = Math.sin(angle) * velocity;

          gsap.fromTo(particle,
            { opacity: 1, scale: 1 },
            {
              x: tx,
              y: ty,
              opacity: 0,
              scale: 0,
              duration: 0.8 + Math.random() * 0.4,
              ease: "power2.out",
              onComplete: () => particle.remove()
            }
          );
        }
      }

      // Letter burst effect on click
      function createLetterBurst(letter, container) {
        const rect = letter.getBoundingClientRect();
        const containerRect = container.getBoundingClientRect();
        const particleCount = 20;

        for (let i = 0; i < particleCount; i++) {
          const particle = document.createElement('div');
          particle.className = 'name-particle';

          const x = rect.left - containerRect.left + rect.width / 2;
          const y = rect.top - containerRect.top + rect.height / 2;

          particle.style.left = `${x}px`;
          particle.style.top = `${y}px`;

          // Random colors for rainbow effect
          const colors = ['#ff0000', '#ff7f00', '#ffff00', '#00ff00', '#0000ff', '#4b0082', '#9400d3'];
          particle.style.background = colors[Math.floor(Math.random() * colors.length)];

          container.appendChild(particle);

          const angle = Math.random() * Math.PI * 2;
          const velocity = 50 + Math.random() * 50;
          const tx = Math.cos(angle) * velocity;
          const ty = Math.sin(angle) * velocity;

          gsap.fromTo(particle,
            { opacity: 1, scale: 1.5 },
            {
              x: tx,
              y: ty,
              opacity: 0,
              scale: 0,
              rotation: Math.random() * 360,
              duration: 1 + Math.random() * 0.5,
              ease: "power2.out",
              onComplete: () => particle.remove()
            }
          );
        }
      }

      // Setup interactions
      const firstNameParticles = document.getElementById('first-name-particles');
      const lastNameParticles = document.getElementById('last-name-particles');

      setupLetterInteractions(firstNameLetters, firstNameParticles);
      setupLetterInteractions(lastNameLetters, lastNameParticles);

      // Continuous ambient animation - faster wave effect
      function waveAnimation(letters, delay = 0) {
        letters.forEach((letter, index) => {
          gsap.to(letter, {
            y: -15,
            duration: 0.4,
            delay: delay + index * 0.08,
            ease: "power2.inOut",
            yoyo: true,
            repeat: -1,
            repeatDelay: 1.5
          });
        });
      }

      // Start ambient wave animation
      setTimeout(() => {
        waveAnimation(firstNameLetters, 0);
        waveAnimation(lastNameLetters, 0.3);
      }, 800);

      // More frequent random glitch effect
      setInterval(() => {
        const allLetters = [...firstNameLetters, ...lastNameLetters];
        const randomLetter = allLetters[Math.floor(Math.random() * allLetters.length)];

        // Force glitch class and ensure it's visible
        randomLetter.classList.add('glitch');
        randomLetter.style.animation = 'glitch 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) both';

        setTimeout(() => {
          randomLetter.classList.remove('glitch');
          randomLetter.style.animation = '';
        }, 300);
      }, 2000); // Every 2 seconds instead of 4
    }, 500); // Split letters after initial fade
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNameEffects);
  } else {
    initNameEffects();
  }
</script>
